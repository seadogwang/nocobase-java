# Build outputs
/target/
*.class
*.jar
*.war

# Runtime/local data
/storage/
/test-token.txt

# IDE/editor
.idea/
.vscode/
*.iml

# Agent/local tooling
.claude/
.runtime*/

# Logs
*.log
/runtime_logs/

# HAR recordings
*.har
# Keep the sanitized HAR fixture (test resource); exclude all raw captures.
!src/test/resources/har/sanitized-sample.har

# Secrets / credentials / generated dumps — never commit
*.dump
*.sql.dump
*.pem
*.key
*.keystore
.env
.env.*

# Test output/reports
/test-output/
/test-reports/

# Runtime smoke/backup evidence (regenerated on demand; non-secret)
smoke_evidence.txt
backup_restore_evidence.txt

# Agent working notes (not project documentation)
docs/superpowers/

# Dev task journals / phase summaries — kept locally, NOT pushed to remote
/*.md
!README.md
!CHANGELOG.md
!BACKEND_OPERATION_GUIDE.md
!RELEASE_READINESS_CHECKLIST.md
!RELEASE_GATE_RESULT.md
!AUDIT_COVERAGE_MATRIX.md
!SYSTEM_MODULE_API_GAP_ANALYSIS.md
!SQL_QUERY_COLLECTION_DESIGN.md
