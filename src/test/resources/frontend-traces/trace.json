      "expectedShape": {
        "data": "map",
        "data.title": "string"
      },
      "assertNoField": ["data.jwtSecret", "data.dbPassword", "data.password"]
    },
    {
      "name": "[NEGATIVE] System settings update with sensitive key",
      "method": "POST",
      "path": "/api/systemSettings:update",
