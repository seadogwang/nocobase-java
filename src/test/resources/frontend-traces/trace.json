    {
      "name": "[NEGATIVE] System settings without auth",
      "method": "GET",
      "path": "/api/systemSettings:get",
      "requiresAuth": false,
      "expectedStatus": 403,
      "negativeAssertion": true,
      "expectedShape": {
        "errors[0].message": "string"
      }
    },
    {
      "name": "UI schema - get tree",
      "method": "GET",
      "path": "/api/uiSchemas:getTree",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data": "map",
        "data.x-uid": "string",
        "data.type": "string"
