{
  "trace": "noco-base-frontend-startup",
  "description": "Simulates a full frontend startup sequence: login, auth check, init, plugin load, system settings, UI schema, collection manager, field manager, basic CRUD, ACL query, data sources read-only paths. Supports variable extraction, request dependencies, negative assertions, and field shape verification.",
  "variables": {},
  "steps": [
    {
      "name": "Login - obtain auth token",
      "method": "POST",
      "path": "/api/auth:signIn",
      "body": {
        "email": "admin@nocobase.com",
        "password": "admin123"
      },
      "requiresAuth": false,
      "expectedStatus": 200,
      "expectedShape": {
        "data.token": "string",
        "data.user.id": "number",
        "data.user.email": "string",
        "data.user.nickname": "string"
      },
      "extract": {
        "authToken": "$.data.token",
        "userId": "$.data.user.id"
      }
    },
    {
      "name": "[NEGATIVE] Login with wrong password",
      "method": "POST",
      "path": "/api/auth:signIn",
      "body": {
        "email": "admin@nocobase.com",
        "password": "WRONG_PASSWORD"
      },
      "requiresAuth": false,
      "expectedStatus": 401,
      "negativeAssertion": true,
      "expectedShape": {
        "errors[0].message": "string"
      },
      "assertNoField": ["data.token"]
    },
    {
      "name": "Auth check - verify token is valid",
      "method": "GET",
      "path": "/api/auth:check",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data.id": "number",
        "data.email": "string",
        "data.nickname": "string"
      }
    },
    {
      "name": "Auth user - get current user profile",
      "method": "GET",
      "path": "/api/auth:user",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data.id": "number",
        "data.email": "string",
        "data.nickname": "string"
      },
      "assertNoField": ["data.password"]
    },
    {
      "name": "[NEGATIVE] Auth check without token",
      "method": "GET",
      "path": "/api/auth:check",
      "requiresAuth": false,
      "expectedStatus": 401,
      "negativeAssertion": true,
      "expectedShape": {
        "errors[0].message": "string"
      }
    },
    {
      "name": "Application plugins - list enabled",
      "method": "GET",
      "path": "/api/applicationPlugins:listEnabled",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data": "array",
        "data[0].name": "string",
        "data[0].packageName": "string",
        "data[0].enabled": "boolean"
      }
    },
    {
      "name": "[NEGATIVE] Application plugins without auth",
      "method": "GET",
      "path": "/api/applicationPlugins:listEnabled",
      "requiresAuth": false,
      "expectedStatus": 403,
      "negativeAssertion": true,
      "expectedShape": {
        "errors[0].message": "string"
      }
    },
    {
      "name": "Plugins - list all",
      "method": "GET",
      "path": "/api/plugins:list",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data": "array",
        "data[0].name": "string",
        "data[0].packageName": "string"
      }
    },
    {
      "name": "Plugins - list enabled",
      "method": "GET",
      "path": "/api/plugins:enabled",
      "requiresAuth": true,
      "expectedStatus": 200,
      "expectedShape": {
        "data": "array"
      }
    },
    {
